<div class="hxchat" data-hxchat-thread><div id="abc-messages" data-chat-region="messages"><div class="hxchat-msg" data-role="user" data-message-id="m1"><p>Hello &lt;world&gt;</p></div><div class="hxchat-msg" data-role="assistant" data-message-id="m2"><p>Hi there</p><div class="hxchat-tool" data-tool-call-id="t1"><span class="hxchat-tool-name">search</span><pre class="hxchat-tool-args">{&#34;q&#34;:&#34;x&#34;}</pre><pre class="hxchat-tool-result">ok</pre></div></div></div><div id="abc-composer" data-chat-region="composer"><form class="hxchat-composer" data-chat-composer method="post" action="abc/messages"><textarea name="text" rows="2" placeholder="Write a message..."></textarea><button type="submit">Send</button></form></div><div id="abc-status" data-chat-region="status"><div class="hxchat-status" data-phase="idle" role="status">Ready.</div></div><div id="abc-error" data-chat-region="error"></div>