package icon

// Spinner — rotating circle progress indicator (not in heroicons).
templ Spinner(class string) {
    <svg xmlns="http://www.w3.org/2000/svg" class={ templ.KV(class, class != "") } width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" stroke-linecap="round"/>
    </svg>
}